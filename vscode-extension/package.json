{
  "name": "coding-rabbit",
  "displayName": "CodingRabbit",
  "description": "C++ CodingRabbit Teaching Assistant via Ollama",
  "version": "0.0.10",
  "publisher": "berkeley",
  "repository": "https://github.com/berkeley/coding-rabbit",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "CodingRabbit",
      "properties": {
        "codingRabbit.apiUrl": {
          "type": "string",
          "default": "http://host.docker.internal:8000/api/chat",
          "description": "The backend API URL for the CodingRabbit model."
        },
        "codingRabbit.modelName": {
          "type": "string",
          "default": "codingrabbit-ta",
          "description": "The name of the Ollama model to use."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coding-rabbit-explorer",
          "title": "CodingRabbit",
          "icon": "media/rabbit.svg"
        }
      ]
    },
    "views": {
      "coding-rabbit-explorer": [
        {
          "type": "webview",
          "id": "coding-rabbit.chatView",
          "name": "TA Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "coding-rabbit.startTerminal",
        "title": "CodingRabbit: Start Tracked Terminal"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "marked": "^12.0.0",
    "node-pty": "^1.1.0",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/marked": "^5.0.2",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  }
}
