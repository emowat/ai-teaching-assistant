# Qdrant Cloud
QDRANT_URL=https://your-cluster-id.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=course_knowledge

# Cohere
COHERE_API_KEY=your-cohere-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Service
APP_HOST=0.0.0.0
APP_PORT=8000
GRADIO_PORT=7860
ADMIN_TOKEN=change-me
LOG_LEVEL=INFO

# Cognito (Phase 1 auth — see local_docs/auth_mvp_minimal_path.md)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX/.well-known/jwks.json

# Frontend (Vite) — reads COGNITO_* vars above via envPrefix in vite.config.ts
# Only frontend-only vars need the VITE_ prefix here
# From Cognito → App integration → Domain (e.g. us-east-1z5dab8wni.auth.us-east-1.amazoncognito.com)
VITE_COGNITO_DOMAIN=https://your-prefix.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/logout
VITE_API_BASE_URL=http://localhost:8001
# Global fallback Codespaces launch targets for the student route
# Professor-configured per-week values in the dashboard override these when set.
VITE_CODESPACES_TEMPLATE_URL=https://github.com/your-org/your-assignment-template
VITE_CODESPACES_REPO_URL=https://github.com/your-org/your-course-repo

# C++ sandbox runner (Phase 1 — local Docker)
# Build image: ./scripts/build-runner.sh
RUNNER_MODE=docker
RUNNER_IMAGE=codingrabbit-cpp-runner:0.1
CORS_ORIGINS=http://localhost:5173

# Inference routing (POST /api/chat — VS Code extension endpoint)
# Defaults also live in deploy/deployment.yaml — env vars override YAML.
# USE_SAGEMAKER=false → forwards to local Ollama (default, for dev)
# USE_SAGEMAKER=true  → SageMaker Async Inference + S3 (production)
USE_SAGEMAKER=false
OLLAMA_URL=http://localhost:11434/api/chat
SAGEMAKER_ENDPOINT=codingrabbit-qwen-async
SAGEMAKER_INFERENCE_BACKEND=vllm
SAGEMAKER_POLL_TIMEOUT_SECONDS=600
S3_DATA_BUCKET=codingrabbit-data-dev
# MODEL_FAMILY controls the chat template: llama3 | qwen | generic
MODEL_FAMILY=qwen
RESTART_COMMAND=

# Input guardrail (pre-RAG)
INPUT_GUARDRAILS_ENABLED=true
INPUT_GUARDRAILS_CODEBERT_S3_URI=s3://codingrabbit-data-dev/models/guardrails/input_codebert_v1/
INPUT_GUARDRAILS_CODEBERT_CHECKPOINT_DIR=input_guardrails/models/checkpoints/input_codebert_v1
INPUT_GUARDRAILS_CODEBERT_PASS_BELOW=0.30
INPUT_GUARDRAILS_CODEBERT_BLOCK_ABOVE=0.70

# AWS credentials for deploy scripts (S3 upload, SageMaker) — SSO profile from ~/.aws/config
# Run: aws sso login --profile codingrabbit-dev  (use --no-browser in WSL if biometrics fail)
AWS_PROFILE=codingrabbit-dev
AWS_REGION=us-east-1

# ECS ingestion worker deployment / launch
# Backend launcher values for /admin/ingestion/launch and task registration
INGESTION_ECS_IMAGE_URI=123456789012.dkr.ecr.us-east-1.amazonaws.com/codingrabbit-ingestion:latest
INGESTION_ECS_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/ecsTaskExecutionRole
INGESTION_ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/codingrabbit-ingestion-task
INGESTION_ECS_TASK_FAMILY=codingrabbit-ingestion-worker
INGESTION_ECS_TASK_DEFINITION=codingrabbit-ingestion-worker
INGESTION_ECS_CONTAINER_NAME=ingestion-worker
INGESTION_ECS_CPU=1024
INGESTION_ECS_MEMORY=2048
INGESTION_ECS_LOG_GROUP=/ecs/codingrabbit-ingestion-worker
INGESTION_ECS_LOG_STREAM_PREFIX=ecs
INGESTION_ECS_CLUSTER=codingrabbit-ingestion
INGESTION_ECS_LAUNCH_TYPE=FARGATE
INGESTION_ECS_PLATFORM_VERSION=LATEST
INGESTION_ECS_ASSIGN_PUBLIC_IP=ENABLED
INGESTION_ECS_SUBNETS=subnet-aaaaaaaa,subnet-bbbbbbbb
INGESTION_ECS_SECURITY_GROUPS=sg-aaaaaaaa
INGESTION_ECS_SECRET_ARNS_JSON='{"INGESTION_JOBS_DATABASE_URL":"arn:aws:secretsmanager:...","COURSE_REGISTRY_DATABASE_URL":"arn:aws:secretsmanager:...","QDRANT_API_KEY":"arn:aws:secretsmanager:..."}'
INGESTION_JOBS_CONNECT_TIMEOUT_SECONDS=20

# Guardrail checkpoint restore from S3
# Download with: ./deploy/scripts/restore-guardrail-checkpoint.sh
GUARDRAILS_CODEBERT_S3_URI=s3://codingrabbit-data-dev/models/guardrails/codebert_v2_1/model.tar.gz
GUARDRAILS_CODEBERT_CHECKPOINT_DIR=output_guardrails/models/checkpoints/codebert_v2_1

# Aurora/PostgreSQL course registry for runtime course routing
# Example: postgresql://user:password@aurora-endpoint:5432/postgres?sslmode=require
COURSE_REGISTRY_DATABASE_URL=
# Optional shared fallback if you already export a generic DATABASE_URL
DATABASE_URL=

# Optional overrides
EMBEDDING_MODEL=sentence-transformers/multi-qa-mpnet-base-dot-v1

# Synthetic transcript generation
# Set the matching provider in `synthetic-transcripts/generate_dataset.py`.
GROQ_API_KEY=your-groq-api-key
TOGETHER_API_KEY=your-together-api-key

# Hugging Face Hub
HF_TOKEN=your-hugging-face-token
