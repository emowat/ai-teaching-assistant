# Qdrant Cloud
QDRANT_URL=https://your-cluster-id.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=course_knowledge

# Cohere
COHERE_API_KEY=your-cohere-api-key

# Service
APP_HOST=0.0.0.0
APP_PORT=8000
GRADIO_PORT=7860
ADMIN_TOKEN=change-me
LOG_LEVEL=INFO

# Optional overrides
EMBEDDING_MODEL=sentence-transformers/multi-qa-mpnet-base-dot-v1

# Synthetic transcript generation
# Set the matching provider in `synthetic-transcripts/generate_dataset.py`.
GROQ_API_KEY=your-groq-api-key
TOGETHER_API_KEY=your-together-api-key

# Hugging Face Hub
HF_TOKEN=your-hugging-face-token
